{
  "name": "mcg-golf-time",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "routes": [ { "pattern": "mcgtee.com", "custom_domain": true }, { "pattern": "www.mcgtee.com", "custom_domain": true } ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "UPSTREAM", "class_name": "UpstreamCache" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UpstreamCache"] }],
  "observability": { "enabled": true }
}
